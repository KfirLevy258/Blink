# Application Kconfig. Zephyr sources this in place of its own root, so the
# trailing `source "Kconfig.zephyr"` is mandatory -- without it every upstream
# symbol disappears.

menu "Blink"

config BLINK_TOUCH_TRACE
	bool "Touch trace diagnostic"
	depends on INPUT_XPT2046
	help
	  Record every XPT2046 report into a RAM ring and dump it as CSV over
	  the console when the finger lifts. Diagnostic only -- enable via
	  trace.conf, never in a release build.

config BLINK_PANEL_PILOT
	bool "Build for the two pilot (POC) display panels"
	help
	  The production batch and the two pilot boards carry different
	  display modules. Measured on hardware 2026-08-21, the production
	  panels differ three ways: they render mirrored, they are wired RGB
	  where the ILI9341 driver hardcodes BGR, and their backlight is far
	  brighter at the same PWM duty. The firmware compensates for all
	  three by default, because production is what ships.

	  Set this when building for one of the two pilot boards, which need
	  none of that compensation and would otherwise come out mirrored,
	  colour-swapped and dim. Enable it through pilot.conf:

	    west build -b esp32_devkitc/esp32/procpu . -- \
	      -DEXTRA_CONF_FILE=pilot.conf

	  Deliberately NOT derived from flash encryption. The pilots happen to
	  be the only fused boards today, so keying off FLASH_CRYPT_CNT would
	  work right now and then quietly break: production units get fused
	  before shipping, and the rule would build pilot firmware for them.

config BLINK_BL_SCALE_PCT
	int "Backlight duty as a percent of the nominal level"
	range 10 100
	default 100 if BLINK_PANEL_PILOT
	default 60
	help
	  Scales every brightness step, so that a given user-facing percent
	  means the same amount of light on either batch. Compared side by
	  side at an identical setting, the production panel had to be
	  stepped down before it matched a pilot, so it is scaled here rather
	  than by lowering the default level -- which would have shrunk the
	  usable 20..100 range instead of recentring it.

config BLINK_FATAL_SELFTEST
	bool "Fault on purpose, to test the fatal handler on a board"
	help
	  Board test for src/fatal.c only. The firmware writes through a NULL
	  pointer from the system workqueue once it has been up
	  BLINK_FATAL_SELFTEST_AT_S seconds, on every boot, so the halt inside
	  the 30 s window, the reboot after it and the streak that halts the
	  fourth reboot can all be watched without hand-patching the source.
	  The boot log says SELFTEST BUILD.

	  Never in prj.conf or any .conf a release reads. Set it on the command
	  line, in a build directory of its own, because a -D value is kept in
	  that directory's CMake cache and a later plain build there would
	  still carry it:

	    west build --sysbuild -d build-selftest -b esp32_devkitc/esp32/procpu . -- \
	      -DSB_CONFIG_BOOTLOADER_MCUBOOT=y -DUSE_CCACHE=0 \
	      -DSB_CONFIG_BOOT_SIGNATURE_KEY_FILE="\"$HOME/.blink/ota_signing_key_p256.pem\"" \
	      -Dfirmware_CONFIG_BLINK_FATAL_SELFTEST=y \
	      -Dfirmware_CONFIG_BLINK_FATAL_SELFTEST_AT_S=60

	  then flash that directory, not build-sb:

	    BLINK_BUILD_DIR=$PWD/build-selftest ../tools/burn.sh --edition claude --no-build --selftest

	  (or --edition codex: the edition is stamped on the unit as on any
	  burn).

	  burn.sh refuses this build without --selftest, and release.sh and
	  flash_encrypted.sh refuse it outright (tools/lib_selftest.sh).

config BLINK_FATAL_SELFTEST_AT_S
	int "Uptime at which the selftest faults, in seconds"
	depends on BLINK_FATAL_SELFTEST
	range 1 3600
	default 60
	help
	  Under 30 to test the halt, over 30 to test the reboot.

config BLINK_TOUCH_INJECT
	bool "Let the PC drive the touch panel (bench builds only)"
	depends on INPUT_XPT2046
	help
	  BENCH BUILDS ONLY. NEVER SHIP THIS.

	  Accepts {"t":"touch",...} lines over the cable and plays them into
	  the XPT2046's input device as panel reports, so LVGL and ui_swipe
	  both see a finger that is not there; and answers {"t":"ui_state"}
	  with the screen and overlay on show. tools/board_touch.py drives it,
	  so every on-board interaction can be tested with nobody at the
	  panel (src/touch_inject.h has the wire). A shipped board with this
	  in it could be operated by anything on the computer it is plugged
	  into, so it is off by default and must stay out of prj.conf and of
	  every .conf a release reads. The boot log says INJECT BUILD.

	  Set it on the command line, in a build directory of its own -- a -D
	  value stays in that directory's CMake cache, and a later plain build
	  there would still carry it:

	    west build -p always --sysbuild -d build-inject \
	      -b esp32_devkitc/esp32/procpu . -- \
	      -DSB_CONFIG_BOOTLOADER_MCUBOOT=y -DUSE_CCACHE=0 \
	      -DSB_CONFIG_BOOT_SIGNATURE_KEY_FILE="\"$HOME/.blink/ota_signing_key_p256.pem\"" \
	      -Dfirmware_CONFIG_BLINK_TOUCH_INJECT=y

	  then flash that directory, not build-sb:

	    BLINK_BUILD_DIR=$PWD/build-inject ../tools/burn.sh --edition claude --no-build --bench

	  (or --edition codex: the edition is stamped on the unit as on any
	  burn). burn.sh refuses this build without --bench, and release.sh and
	  flash_encrypted.sh refuse it outright (tools/lib_selftest.sh).

endmenu

source "Kconfig.zephyr"
