/*
 * ESP32-2432S028 "Cheap Yellow Display" (CYD).
 *
 * No upstream Zephyr board exists for this hardware, so we build against the
 * stock esp32_devkitc and describe the board's wiring here.
 *
 * Display is on SPI2/HSPI: MISO 12, MOSI 13, SCLK 14, CS 15, DC 2, backlight 21.
 * TFT reset is NOT wired to a GPIO on this board (it is tied high), so there is
 * deliberately no reset-gpios property anywhere below.
 *
 * Note the pinctrl group below omits SPIM2_CSEL_GPIO15: chip-select must be a
 * plain GPIO, not the SPI peripheral's hardware CS. The panel requires CS to be
 * held low across a command byte *and* its following data phase (DC changes in
 * between), which hardware CS cannot do -- it de-asserts after every transfer.
 */
#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <dt-bindings/pinctrl/esp32-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32-gpio-sigmap.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	chosen {
		zephyr,display = &ili9341;
	};
};

/*
 * Flash-encryption compatibility: encrypted flash writes happen in 32-byte
 * blocks, and CONFIG_ESP_FLASH_ENCRYPTION is gated on the devicetree
 * saying so. This changes the NVS on-flash format -- switching it costs
 * one re-provisioning.
 */
&flash0 {
	write-block-size = <32>;
};

/ {

	/*
	 * A SECOND WiFi instance, which becomes the soft-AP interface.
	 * Without it the driver has only one net_if: the AP broadcasts and a
	 * phone can associate, but nothing answers its DHCP request and it
	 * spins forever on "obtaining IP address". Matches Zephyr's own
	 * samples/net/wifi/apsta_mode overlay.
	 */
	wifi_ap: wifi_ap {
		compatible = "espressif,esp32-wifi";
		status = "okay";
	};

	/* Backlight on LEDC PWM channel 0 (it was a plain on/off GPIO), so
	 * night mode can dim it instead of choosing between blinding and
	 * blank. 1 kHz: far above flicker perception, low enough for the
	 * LEDC low-speed timer at full resolution. */
	pwmleds {
		compatible = "pwm-leds";
		backlight: backlight {
			pwms = <&ledc0 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
			label = "TFT backlight";
		};
	};

	/*
	 * The panel does not drive MISO on this board -- reads return zeros, so
	 * the controller cannot be interrogated and the link is write-only.
	 */
	/*
	 * Solved against lvgl_pointer_input.c's actual transform (invert
	 * flags apply BEFORE its ROTATED_90 compensation, in the panel
	 * frame -- naive flag-flipping from on-screen symptoms therefore
	 * misleads: an invert-y here moves screen X). With the panel's
	 * swapped channel frame above, the R90 compensation supplies the
	 * un-swap, and screen-y needs the pre-rotation invert-x to cancel
	 * the compensation's own flip:
	 *   screen_x = ABS_Y                 (horizontal, 0..319)
	 *   screen_y = 240 - (240 - ABS_X)   (vertical,   0..239)
	 * Verified end-to-end with the on-screen touch marker 2026-07-14.
	 */
	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&xpt2046>;
		invert-x;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		dc-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		spi-dev = <&spi2>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		ili9341: ili9341@0 {
			compatible = "ilitek,ili9341";
			reg = <0>;
			/* Overclock ladder on THIS unit (verified on hardware
			 * 2026-07-17): 40 MHz = solid white (init never
			 * latches); 32 MHz renders clean and is the keeper;
			 * 25 MHz is the conservative fallback if a future
			 * panel swap misbehaves. */
			mipi-max-frequency = <32000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			pixel-format = <0>;   /* RGB565 */
			/* Panel is portrait-native (240x320) but the board is mounted
			 * landscape, so rotate to present 320x240.
			 */
			rotation = <90>;
			width = <240>;
			height = <320>;
		};
	};
};

&pinctrl {
	spim2_cyd: spim2_cyd {
		group1 {
			pinmux = <SPIM2_MISO_GPIO12>,
				 <SPIM2_SCLK_GPIO14>;
		};

		group2 {
			pinmux = <SPIM2_MOSI_GPIO13>;
			output-low;
		};
	};

	ledc0_cyd: ledc0_cyd {
		group1 {
			pinmux = <LEDC_CH0_GPIO21>;
			output-enable;
		};
	};

	/* Touch bus: CS (GPIO33) is a plain GPIO, so no SPIM3_CSEL here. */
	spim3_cyd: spim3_cyd {
		group1 {
			pinmux = <SPIM3_MISO_GPIO39>,
				 <SPIM3_SCLK_GPIO25>;
		};

		group2 {
			pinmux = <SPIM3_MOSI_GPIO32>;
			output-low;
		};
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spim2_cyd>;
	pinctrl-names = "default";
	/*
	 * Feed the panel by DMA instead of hand-loading the SPI FIFO. Measured
	 * on hardware 2026-07-26: a full 320x240x2 frame took 63 ms polled --
	 * 19.5 Mbit/s against a 32 MHz wire, so a third of every frame was
	 * per-transfer CPU overhead rather than clock. The flush half of an
	 * LVGL refresh measured 65-67 ms, matching that almost exactly.
	 *
	 * esp32_common.dtsi already supplies dma-clk and dma-host = <0>; this
	 * only switches the path on. The ESP32 predates GDMA, so the driver
	 * takes its own DPORT_SPI_DMA_CHAN_SEL_REG branch, not the gdma one.
	 * Note DMA caps a single transfer at 4092 bytes, so the 6144-byte VDB
	 * chunk is split in two -- more descriptors, still far less overhead.
	 */
	dma-enabled;
	cs-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
	#address-cells = <1>;
	#size-cells = <0>;
};

&ledc0 {
	pinctrl-0 = <&ledc0_cyd>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

/*
 * Touch (XPT2046) is on SPI3, but NOT on SPI3's native IOMUX pins -- those
 * (18/19/23/5) go to the microSD slot on this board. Touch is reached through
 * the GPIO matrix instead: CLK 25, MOSI 32, MISO 39, CS 33, IRQ 36.
 *
 * GPIO 36 and 39 are input-only pins, so they must never be configured as
 * outputs. On the ESP32, gpio0 covers pins 0-31 and gpio1 covers 32-39
 * (index = gpio number - 32), hence GPIO33 -> &gpio1 1 and GPIO36 -> &gpio1 4.
 *
 * We do not use the microSD card, which is what lets touch and SD avoid the
 * SPI3 bus contention that this board is notorious for in the Arduino world.
 */
&spi3 {
	status = "okay";
	pinctrl-0 = <&spim3_cyd>;
	pinctrl-names = "default";
	cs-gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;	/* GPIO33 */
	#address-cells = <1>;
	#size-cells = <0>;

	xpt2046: xpt2046@0 {
		compatible = "xptek,xpt2046";
		reg = <0>;
		spi-max-frequency = <2000000>;	/* XPT2046 is a slow part */
		int-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;	/* GPIO36, input-only */

		/* Re-measured 2026-07-14 by corner taps on THIS unit: the touch
		 * controller's X channel tracks the screen's horizontal (long)
		 * edge and Y its vertical -- already in landscape screen frame,
		 * NO swap (the earlier CYD-T4 measurement said the transpose;
		 * that mapping put every tap on the mirrored button). Sizes are
		 * therefore the landscape 320x240.
		 */
		/* Channel frame (portrait): ABS_X is the panel's VERTICAL,
		 * ABS_Y its HORIZONTAL -- the lvgl_pointer glue's rotation
		 * compensation maps them into landscape screen space. ADC
		 * ranges fitted from two measurement sessions (driver event
		 * dump + on-screen marker, 2026-07-14). */
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		/* Re-fitted 2026-07-21 with the on-screen 5-target calibration
		 * (run_touch_cal), two passes -- the second with 3-tap median
		 * averaging after the first pass's noisy single taps mis-set the
		 * vertical. Horizontal (min-y/max-y) landed at ~1.0 in pass 1;
		 * vertical (min-x/max-x) needed pass 2 to shed a +10% gain and a
		 * ~24px "reads too high" offset. */
		min-x = <559>;
		max-x = <3818>;
		min-y = <321>;
		max-y = <3626>;

		z-threshold = <400>;
		/* Default is a single raw sample per report -- visibly jittery
		 * on this panel (slides "not clean", 2026-07-15). 8 reads are
		 * averaged per report; the 2 MHz SPI absorbs it easily. (A
		 * stray duplicate "reads = <3>" was silently winning here --
		 * last-one-wins in DTS -- which is why touch felt worse than
		 * this comment promised; removed 2026-07-17.) 16 now: the cal
		 * harness saw occasional 77px jitter on a hold; more averaging
		 * per report smooths it, and 2 MHz SPI still absorbs it. */
		reads = <16>;
	};
};

/* --- OTA: scratch partition for MCUboot swap-with-revert ---
 * The appcpu slots are dead weight on this single-image (procpu-only) build;
 * their 0xF0000 hole between slot1 and storage becomes MCUboot's scratch.
 * storage_partition does NOT move: WiFi creds, token, settings all survive.
 *
 * Under this Zephyr revision, partitions_0x1000_amp_4M.dtsi also carves
 * lpcore slot0/slot1 (0x3A0000-0x3B0000) out of that same hole -- the ESP32
 * has no LP core, this is just a shared AMP partition template -- and it
 * already defines its own scratch_partition node (0x3E0000, 124 KB, past
 * storage). All five must go: the lpcore slots so the new scratch can span
 * the *entire* hole down to storage's start, and the old scratch_partition
 * because MCUboot looks it up by devicetree node label (FIXED_PARTITION_ID),
 * not by the "label" string, so two nodes named scratch_partition would
 * collide.
 */
/delete-node/ &slot0_appcpu_partition;
/delete-node/ &slot1_appcpu_partition;
/delete-node/ &slot0_lpcore_partition;
/delete-node/ &slot1_lpcore_partition;
/delete-node/ &scratch_partition;

&flash0 {
	partitions {
		scratch_partition: partition@2c0000 {
			label = "image-scratch";
			reg = <0x2C0000 0xF0000>;
		};
	};
};
