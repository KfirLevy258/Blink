/*
 * ESP32-2432S028 "Cheap Yellow Display" (CYD).
 *
 * No upstream Zephyr board exists for this hardware, so we build against the
 * stock esp32_devkitc and describe the board's wiring here.
 *
 * Display is on SPI2/HSPI: MISO 12, MOSI 13, SCLK 14, CS 15, DC 2, backlight 21.
 * TFT reset is NOT wired to a GPIO on this board (it is tied high), so there is
 * deliberately no reset-gpios property anywhere below.
 *
 * Note the pinctrl group below omits SPIM2_CSEL_GPIO15: chip-select must be a
 * plain GPIO, not the SPI peripheral's hardware CS. The panel requires CS to be
 * held low across a command byte *and* its following data phase (DC changes in
 * between), which hardware CS cannot do -- it de-asserts after every transfer.
 */
#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <dt-bindings/pinctrl/esp32-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32-gpio-sigmap.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
	chosen {
		zephyr,display = &ili9341;
	};

	/*
	 * A SECOND WiFi instance, which becomes the soft-AP interface.
	 * Without it the driver has only one net_if: the AP broadcasts and a
	 * phone can associate, but nothing answers its DHCP request and it
	 * spins forever on "obtaining IP address". Matches Zephyr's own
	 * samples/net/wifi/apsta_mode overlay.
	 */
	wifi_ap: wifi_ap {
		compatible = "espressif,esp32-wifi";
		status = "okay";
	};

	/* Backlight is a plain active-high GPIO. */
	leds {
		compatible = "gpio-leds";
		backlight: backlight {
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
			label = "TFT backlight";
		};
	};

	/*
	 * The panel does not drive MISO on this board -- reads return zeros, so
	 * the controller cannot be interrogated and the link is write-only.
	 */
	/*
	 * Solved against lvgl_pointer_input.c's actual transform (invert
	 * flags apply BEFORE its ROTATED_90 compensation, in the panel
	 * frame -- naive flag-flipping from on-screen symptoms therefore
	 * misleads: an invert-y here moves screen X). With the panel's
	 * swapped channel frame above, the R90 compensation supplies the
	 * un-swap, and screen-y needs the pre-rotation invert-x to cancel
	 * the compensation's own flip:
	 *   screen_x = ABS_Y                 (horizontal, 0..319)
	 *   screen_y = 240 - (240 - ABS_X)   (vertical,   0..239)
	 * Verified end-to-end with the on-screen touch marker 2026-07-14.
	 */
	lvgl_pointer {
		compatible = "zephyr,lvgl-pointer-input";
		input = <&xpt2046>;
		invert-x;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		dc-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		spi-dev = <&spi2>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		ili9341: ili9341@0 {
			compatible = "ilitek,ili9341";
			reg = <0>;
			mipi-max-frequency = <25000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			pixel-format = <0>;   /* RGB565 */
			/* Panel is portrait-native (240x320) but the board is mounted
			 * landscape, so rotate to present 320x240.
			 */
			rotation = <90>;
			width = <240>;
			height = <320>;
		};
	};
};

&pinctrl {
	spim2_cyd: spim2_cyd {
		group1 {
			pinmux = <SPIM2_MISO_GPIO12>,
				 <SPIM2_SCLK_GPIO14>;
		};

		group2 {
			pinmux = <SPIM2_MOSI_GPIO13>;
			output-low;
		};
	};

	/* Touch bus: CS (GPIO33) is a plain GPIO, so no SPIM3_CSEL here. */
	spim3_cyd: spim3_cyd {
		group1 {
			pinmux = <SPIM3_MISO_GPIO39>,
				 <SPIM3_SCLK_GPIO25>;
		};

		group2 {
			pinmux = <SPIM3_MOSI_GPIO32>;
			output-low;
		};
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spim2_cyd>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
	#address-cells = <1>;
	#size-cells = <0>;
};

/*
 * Touch (XPT2046) is on SPI3, but NOT on SPI3's native IOMUX pins -- those
 * (18/19/23/5) go to the microSD slot on this board. Touch is reached through
 * the GPIO matrix instead: CLK 25, MOSI 32, MISO 39, CS 33, IRQ 36.
 *
 * GPIO 36 and 39 are input-only pins, so they must never be configured as
 * outputs. On the ESP32, gpio0 covers pins 0-31 and gpio1 covers 32-39
 * (index = gpio number - 32), hence GPIO33 -> &gpio1 1 and GPIO36 -> &gpio1 4.
 *
 * We do not use the microSD card, which is what lets touch and SD avoid the
 * SPI3 bus contention that this board is notorious for in the Arduino world.
 */
&spi3 {
	status = "okay";
	pinctrl-0 = <&spim3_cyd>;
	pinctrl-names = "default";
	cs-gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;	/* GPIO33 */
	#address-cells = <1>;
	#size-cells = <0>;

	xpt2046: xpt2046@0 {
		compatible = "xptek,xpt2046";
		reg = <0>;
		spi-max-frequency = <2000000>;	/* XPT2046 is a slow part */
		int-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;	/* GPIO36, input-only */

		/* Re-measured 2026-07-14 by corner taps on THIS unit: the touch
		 * controller's X channel tracks the screen's horizontal (long)
		 * edge and Y its vertical -- already in landscape screen frame,
		 * NO swap (the earlier CYD-T4 measurement said the transpose;
		 * that mapping put every tap on the mirrored button). Sizes are
		 * therefore the landscape 320x240.
		 */
		/* Channel frame (portrait): ABS_X is the panel's VERTICAL,
		 * ABS_Y its HORIZONTAL -- the lvgl_pointer glue's rotation
		 * compensation maps them into landscape screen space. ADC
		 * ranges fitted from two measurement sessions (driver event
		 * dump + on-screen marker, 2026-07-14). */
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		min-x = <850>;
		max-x = <3650>;
		min-y = <520>;
		max-y = <3500>;

		z-threshold = <400>;
		/* Default is a single raw sample per report -- visibly jittery
		 * on this panel (slides "not clean", 2026-07-15). 8 reads are
		 * averaged per report; the 2 MHz SPI absorbs it easily. */
		reads = <8>;
		reads = <3>;
	};
};
