diff --git a/drivers/flash/flash_esp32.c b/drivers/flash/flash_esp32.c
index 88a3e5031f9..3abd9a3c5d1 100644
--- a/drivers/flash/flash_esp32.c
+++ b/drivers/flash/flash_esp32.c
@@ -341,6 +341,189 @@ static bool flash_esp32_is_aligned(off_t address, void *buffer, size_t length)
 	/* check if address, buffer pointer, and length are 4-byte aligned */
 	return ((address & 3) == 0) && (((uintptr_t)buffer & 3) == 0) && ((length & 3) == 0);
 }
+
+/* LOCAL SDK PATCH -- LiveClaudeUi
+ * tools/patches/zephyr-esp32-mcuboot-encrypted-erase-refill.patch
+ *
+ * Flash-encryption compatibility for the MCUboot-context driver, mirroring
+ * the native MCUboot espressif port (boot/espressif/port/esp_mcuboot.c,
+ * aligned_flash_write/flash_area_erase):
+ *
+ * 1) Erase refills the erased range with ENCRYPTED 0xFF. Erased encrypted
+ *    flash otherwise DECRYPTS AS GARBAGE, and MCUboot's swap/revert state
+ *    machine relies on never-written trailer flags (image_ok) reading as
+ *    erased 0xFF. Without the refill, a TEST-swapped image never
+ *    auto-reverts: its unwritten image_ok decodes as BAD instead of UNSET
+ *    (hardware-proven 2026-07-18, .superpowers/sdd/task-2-debug-report.md).
+ * 2) Refilled bytes are programmed ciphertext, so later writes into an
+ *    erased region cannot be programmed directly any more (NOR flash can
+ *    only clear bits). Every encrypted write therefore becomes a full-sector
+ *    read-merge-erase-write, exactly like the native port's
+ *    aligned_flash_write(..., erase=true).
+ * 3) The hal's decrypt-read path (esp_rom_flash_read(..., true)) reads via a
+ *    cached 64 KB MMU window and only flushes the cache when the window
+ *    changes. After a write or erase we force the next mapped read to remap
+ *    (and thus flush) by touching a different window, so read-back never
+ *    returns stale pre-write bytes.
+ */
+#define MCUBOOT_ENC_SECTOR_SIZE 4096
+static uint8_t mcuboot_enc_sector_buf[MCUBOOT_ENC_SECTOR_SIZE] __aligned(32);
+
+static void mcuboot_enc_cache_inval(off_t near_addr)
+{
+	uint32_t tmp;
+	/* Slots/scratch all sit >= 0x20000, so the 64 KB windows at 0x0 and
+	 * 0x10000 are safe scapegoat mapping targets.
+	 */
+	off_t dummy = (((uint32_t)near_addr & 0xFFFF0000U) == 0x10000U) ? 0x0 : 0x10000;
+
+	(void)esp_rom_flash_read(dummy, &tmp, sizeof(tmp), true);
+}
+
+
+/* Deferred-fill state. Declared here because mcuboot_enc_flash_write() below
+ * consults it; the fill itself is materialised by
+ * mcuboot_enc_flash_flush_pending() further down. */
+static off_t mcuboot_enc_pend_start;
+static size_t mcuboot_enc_pend_len;
+
+static bool mcuboot_enc_overlaps(off_t a, size_t alen, off_t b, size_t blen)
+{
+	return (a < b + (off_t)blen) && (b < a + (off_t)alen);
+}
+
+void mcuboot_enc_flash_flush_pending(void);
+
+static int mcuboot_enc_flash_write(off_t dest_addr, const void *src, size_t size)
+{
+	const size_t sector = MCUBOOT_ENC_SECTOR_SIZE;
+	bool blank = false;	/* target still erased from a deferred fill */
+	int ret;
+
+	if (mcuboot_enc_pend_len != 0) {
+		if (dest_addr <= mcuboot_enc_pend_start &&
+		    dest_addr + (off_t)size >=
+			    mcuboot_enc_pend_start + (off_t)mcuboot_enc_pend_len) {
+			/* Fully overwritten: the fill would have been erased
+			 * again a moment later, so drop it -- and the range is
+			 * still blank, so this write needs no erase either. */
+			mcuboot_enc_pend_len = 0;
+			blank = true;
+		} else if (mcuboot_enc_overlaps(dest_addr, size,
+						mcuboot_enc_pend_start,
+						mcuboot_enc_pend_len)) {
+			/* Partial: the untouched remainder must still read as
+			 * 0xFF, so materialise the fill before writing. */
+			mcuboot_enc_flash_flush_pending();
+		}
+	}
+
+	if (IS_ALIGNED(dest_addr, sector) && IS_ALIGNED(size, sector)) {
+		/* Whole sectors: erase (no refill needed, content follows)
+		 * then program directly.
+		 */
+		ret = blank ? ESP_OK
+			    : esp_rom_flash_erase_range(dest_addr, size);
+		if (ret != ESP_OK) {
+			return ret;
+		}
+		ret = esp_rom_flash_write(dest_addr, (void *)src, size, true);
+		mcuboot_enc_cache_inval(dest_addr);
+		return ret;
+	}
+
+	size_t write_addr = (size_t)dest_addr;
+	size_t bytes_remaining = size;
+	size_t src_offset = 0;
+
+	while (bytes_remaining > 0) {
+		size_t aligned_curr_addr = ROUND_DOWN(write_addr, sector);
+		size_t curr_buf_off = write_addr - aligned_curr_addr;
+		size_t chunk_len = MIN(bytes_remaining, sector - curr_buf_off);
+
+		/* Read-merge-erase-write one full sector */
+		ret = esp_rom_flash_read(aligned_curr_addr, mcuboot_enc_sector_buf,
+					 sector, true);
+		if (ret != ESP_OK) {
+			return ret;
+		}
+		ret = esp_rom_flash_erase_range(aligned_curr_addr, sector);
+		if (ret != ESP_OK) {
+			return ret;
+		}
+		memcpy(&mcuboot_enc_sector_buf[curr_buf_off],
+		       &((const uint8_t *)src)[src_offset], chunk_len);
+		ret = esp_rom_flash_write(aligned_curr_addr, mcuboot_enc_sector_buf,
+					  sector, true);
+		mcuboot_enc_cache_inval(aligned_curr_addr);
+		if (ret != ESP_OK) {
+			return ret;
+		}
+
+		write_addr += chunk_len;
+		src_offset += chunk_len;
+		bytes_remaining -= chunk_len;
+	}
+
+	return ESP_OK;
+}
+
+/* DEFERRED REFILL (2026-07-26). Writing encrypted 0xFF over an erased range is
+ * only observable if something READS that range before writing it -- which is
+ * true for trailer flags (the reason the refill exists) and false for the bulk
+ * image copy, where MCUboot erases a sector and immediately overwrites it. Done
+ * eagerly, every sector of a swap paid a wasted 4 KB write AND forced a second
+ * erase in the write path, because the fill left programmed ciphertext behind.
+ *
+ * So the fill is recorded, not performed. It is materialised on any overlapping
+ * read or partial write, and unconditionally before MCUboot boots -- see
+ * mcuboot_enc_flash_flush_pending(), called from boot/zephyr/main.c just ahead
+ * of do_boot(). A pending fill that is fully overwritten is simply dropped, and
+ * the covering write also skips its own erase since the sector is still blank.
+ *
+ * Only one range is ever pending: a second erase flushes the first.
+ */
+/* Exported: MCUboot calls this immediately before jumping to the image, so a
+ * region erased and never written still decrypts as 0xFF. Without that call an
+ * unwritten image_ok would read as BAD instead of UNSET and a test image would
+ * never auto-revert. */
+void mcuboot_enc_flash_flush_pending(void)
+{
+	off_t start = mcuboot_enc_pend_start;
+	size_t len = mcuboot_enc_pend_len;
+
+	if (len == 0) {
+		return;
+	}
+	mcuboot_enc_pend_len = 0;	/* clear first: writes re-enter here */
+
+	memset(mcuboot_enc_sector_buf, 0xFF, sizeof(mcuboot_enc_sector_buf));
+	for (off_t addr = start; addr < start + (off_t)len;
+	     addr += MCUBOOT_ENC_SECTOR_SIZE) {
+		if (esp_rom_flash_write(addr, mcuboot_enc_sector_buf,
+					MCUBOOT_ENC_SECTOR_SIZE, true) != ESP_OK) {
+			return;
+		}
+	}
+	mcuboot_enc_cache_inval(start);
+}
+
+static int mcuboot_enc_flash_erase(off_t start, size_t len)
+{
+	int ret;
+
+	mcuboot_enc_flash_flush_pending();	/* only one pending range */
+
+	ret = esp_rom_flash_erase_range(start, len);
+	if (ret != ESP_OK) {
+		return ret;
+	}
+	mcuboot_enc_pend_start = start;
+	mcuboot_enc_pend_len = len;
+	mcuboot_enc_cache_inval(start);
+	return ESP_OK;
+}
+/* END LOCAL SDK PATCH */
 #endif
 
 static int flash_esp32_read(const struct device *dev, off_t address, void *buffer, size_t length)
@@ -358,6 +541,17 @@ static int flash_esp32_read(const struct device *dev, off_t address, void *buffe
 	size_t aligned_size = 0;
 	bool allow_decrypt = esp_flash_encryption_enabled();
 
+	/* A deferred 0xFF fill is invisible to the flash itself, so a read that
+	 * lands in it would see raw erased ciphertext (decrypt garbage) instead
+	 * of 0xFF. Materialise it first. Overlap-checked deliberately: the bulk
+	 * copy reads the SOURCE slot while a fill is pending on the DESTINATION,
+	 * and flushing on every read would give back the whole saving. */
+	if (mcuboot_enc_pend_len != 0 &&
+	    mcuboot_enc_overlaps(address, length, mcuboot_enc_pend_start,
+				 mcuboot_enc_pend_len)) {
+		mcuboot_enc_flash_flush_pending();
+	}
+
 	if (flash_esp32_is_aligned(address, buffer, length)) {
 		ret = esp_rom_flash_read(address, buffer, length, allow_decrypt);
 		return (ret == ESP_OK) ? 0 : -EIO;
@@ -424,7 +618,14 @@ static int flash_esp32_write(const struct device *dev, off_t address, const void
 
 	bool encrypt = esp_flash_encryption_enabled();
 
-	ret = esp_rom_flash_write(address, (void *)buffer, length, encrypt);
+	if (encrypt) {
+		/* LOCAL SDK PATCH: sector read-merge-erase-write, required
+		 * because erased regions are refilled with encrypted 0xFF.
+		 */
+		ret = mcuboot_enc_flash_write(address, buffer, length);
+	} else {
+		ret = esp_rom_flash_write(address, (void *)buffer, length, encrypt);
+	}
 #else
 	flash_esp32_sem_take(dev);
 
@@ -461,7 +662,14 @@ static int flash_esp32_erase(const struct device *dev, off_t start, size_t len)
 	int ret = 0;
 
 #ifdef CONFIG_MCUBOOT
-	ret = esp_rom_flash_erase_range(start, len);
+	if (esp_flash_encryption_enabled()) {
+		/* LOCAL SDK PATCH: erase + encrypted-0xFF refill so erased
+		 * flash decrypts as 0xFF for MCUboot's trailer state machine.
+		 */
+		ret = mcuboot_enc_flash_erase(start, len);
+	} else {
+		ret = esp_rom_flash_erase_range(start, len);
+	}
 #else
 	flash_esp32_sem_take(dev);
 
