diff --git a/boot/bootutil/src/loader.c b/boot/bootutil/src/loader.c
index 99658754..3a54e31e 100644
--- a/boot/bootutil/src/loader.c
+++ b/boot/bootutil/src/loader.c
@@ -79,7 +79,25 @@ static struct image_max_size image_max_sizes[BOOT_IMAGE_NUMBER] = {0};
 #if BOOT_MAX_ALIGN > 1024
 #define BUF_SZ BOOT_MAX_ALIGN
 #else
-#define BUF_SZ 1024
+/* LOCAL SDK PATCH -- LiveClaudeUi
+ * tools/patches/mcuboot-copy-buffer-sector-size.patch
+ *
+ * 1024 -> 4096 (one flash sector). On this flash-encrypted ESP32 every write
+ * that is not a whole sector takes the driver's read-merge-erase-write path
+ * (zephyr/drivers/flash/flash_esp32.c, itself a local patch), so a 1 KB copy
+ * chunk rebuilds each 4 KB sector FOUR times: four erases and 16 KB of writes
+ * per 4 KB of image. Matching the chunk to the sector keeps boot_copy_region's
+ * writes sector-aligned, which hits that driver's whole-sector fast path
+ * (erase once, program once) and cuts erase cycles and write volume ~4x.
+ *
+ * Measured before this patch: a 1.28 MB image took 357 s of frozen screen to
+ * swap (host clock, 2026-07-26). Do NOT trust MCUboot's own "I (nnnnn)"
+ * timestamps when re-measuring -- on this SoC they run ~20x fast.
+ *
+ * Costs 3 KB of bootloader .bss. It only fits because swap-using-move freed
+ * dram_seg (97% -> 84%); it would not have fit under swap-using-scratch.
+ */
+#define BUF_SZ 4096
 #endif
 
 #if defined(MCUBOOT_SWAP_USING_OFFSET) && defined(MCUBOOT_ENC_IMAGES)
